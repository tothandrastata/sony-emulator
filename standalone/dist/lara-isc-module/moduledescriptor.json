      "rules": [
        {
          "feId": "5b94c486-592a-4fda-8825-f427b99d0e3a",
          "name": "react to muteStatusChange",
          "enabled": true,
          "actions": {
            "type": "code",
            "steps": [],
            "code": "if (status == \"Muted\") {\n    this.instance.addClass(\"muteButton\", `selected`, this.instance.instanceId);\n    this.instance.removeClass(\"muteButton\", `deselected`, this.instance.instanceId);\n} else {\n    this.instance.addClass(\"muteButton\", `deselected`, this.instance.instanceId);\n    this.instance.removeClass(\"muteButton\", `selected`, this.instance.instanceId);\n} \n"
          },
          "triggers": [
            {
              "type": "event",
              "details": {
                "instanceId": "",
                "event": "muteStatusChanged"
              }
            }
          ],
          "orderId": 0
        },
        {
          "feId": "05a43bc4-5e12-41cc-8f08-6c2ab0ae8e8a",
          "name": "react to powerStatusChange",
          "enabled": true,
          "actions": {
            "code": "if (status == \"On\") {\n    this.instance.addClass(\"powerButton\", `selected`, this.instance.instanceId);\n    this.instance.removeClass(\"powerButton\", `deselected`, this.instance.instanceId);\n} else {\n    this.instance.addClass(\"powerButton\", `deselected`, this.instance.instanceId);\n    this.instance.removeClass(\"powerButton\", `selected`, this.instance.instanceId);\n} \n",
            "type": "code",
            "steps": []
          },
          "triggers": [
            {
              "type": "event",
              "details": {
                "instanceId": "",
                "event": "powerStatusChanged"
              }
            }
          ],
          "condition": {},
          "orderId": 1
        },
        {
          "feId": "42729d29-e415-461c-9a40-a4853aa1858c",
          "name": "react to button click",
          "enabled": true,
          "actions": {
            "code": "console.log(\"Button clicked: \" + buttonId);\n\nif (buttonId == \"powerButton\") {\n    const currValue = await this.instance.variables[`powerStatus`].value;\n    const newValue =  currValue == \"On\" ? \"Off\" : \"On\";\n    await this.instance.setPowerState(newValue);\n}\n\n\nif (buttonId == \"muteButton\") {\n    const currValue = await this.instance.variables[`muteStatus`].value;\n    const newValue =  currValue == \"Muted\" ? \"Unmuted\" : \"Muted\";\n    await this.instance.setMuteState(newValue);\n}\n\n",
            "type": "code",
            "steps": []
          },
          "triggers": [
            {
              "type": "event",
              "details": {
                "instanceId": "",
                "event": "controlButtonClicked"
              }
            }
          ],
